# AVEART Medusa backend — Neon PostgreSQL + Docker-capable host
# Copy to .env for local use. Never commit a real .env file.

# Paste the pooled or direct connection string from the Neon project
# AveartBackend. Use the connection string for the production branch/database.
DATABASE_URL=

# Optional. Leave unset for the simplest single-instance deployment.
# If configured, use a Redis URL shared by all Medusa instances.
REDIS_URL=

# Single-instance setup (no separate worker service)
MEDUSA_WORKER_MODE=shared
PORT=9000
NODE_ENV=production
MIGRATE_ON_BOOT=true
DISABLE_MEDUSA_ADMIN=false

# Required production secrets. Generate separate random values for each.
JWT_SECRET=
COOKIE_SECRET=

# Public backend URL is not configured here: Medusa uses the current host URL.
# Set these to the exact HTTPS origins used by the admin and storefront.
ADMIN_CORS=
AUTH_CORS=
STORE_CORS=

# Admin bootstrap
MEDUSA_ADMIN_EMAIL=delcidioeliasnhatingo@gmail.com
MEDUSA_ADMIN_PASSWORD=

# Debito Pay — set only with values from the merchant dashboard
DEBITOPAY_API_KEY=
DEBITOPAY_MERCHANT_ID=
DEBITOPAY_WALLET_CODE=
DEBITOPAY_API_BASE_URL=https://gyqoaningqhurhvdugne.supabase.co/functions/v1
DEBITOPAY_PAYMENT_ENDPOINT=payment-orchestrator
DEBITOPAY_WEBHOOK_SECRET=
DEBITOPAY_RETURN_URL=
