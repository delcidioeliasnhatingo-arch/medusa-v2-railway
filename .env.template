# ── Core wiring (set automatically by the Railway template) ─────────────────
# Postgres connection (reference: ${{Postgres.DATABASE_URL}} on Railway)
DATABASE_URL=postgres://postgres:password@postgres.railway.internal:5432/railway
# Redis connection (reference: ${{Redis.REDIS_URL}} on Railway; `family=0` is
# appended automatically by medusa-config.ts for Railway's IPv6 proxy)
REDIS_URL=redis://redis.railway.internal:6379

# shared = one service does everything (dev/simple deploys)
# server = serves API + admin;  worker = background jobs (Railway template uses server+worker pair)
MEDUSA_WORKER_MODE=server
PORT=9000

# ── Secrets — generate with `openssl rand -hex 32` (required in production) ─
JWT_SECRET=
COOKIE_SECRET=

# ── URLs / CORS ──────────────────────────────────────────────────────────────
# Public domain of the medusa-server service on Railway
MEDUSA_BACKEND_URL=https://your-app.up.railway.app
ADMIN_CORS=https://your-app.up.railway.app
# Where your storefront will call the Store API from (comma-separated)
STORE_CORS=http://localhost:3000,https://your-storefront.up.railway.app
# Every URL that authenticates users (storefront + admin), comma-separated
AUTH_CORS=https://your-app.up.railway.app,http://localhost:3000

# ── Admin dashboard ──────────────────────────────────────────────────────────
# false on medusa-server (builds & serves /app), true on medusa-worker
DISABLE_MEDUSA_ADMIN=false
# Admin bootstrap — applied on first boot by medusa-server. EMAIL is optional
# (defaults to admin@example.com). PASSWORD is auto-generated by the Railway
# template; retrieve it from the medusa-server service variables, and change it
# from the admin dashboard after first login.
# MEDUSA_ADMIN_EMAIL=admin@example.com
MEDUSA_ADMIN_PASSWORD=

# ── Boot behavior ────────────────────────────────────────────────────────────
# Run `medusa db:migrate` before serving. true on medusa-server,
# false on medusa-worker (the server owns schema changes).
MIGRATE_ON_BOOT=true

# ── Debito Pay payments ──────────────────────────────────────────────────────
# Configure these values from Merchant → Settings → API and Webhooks.
# Never put live secrets in GitHub or a storefront.
DEBITOPAY_API_KEY=
DEBITOPAY_MERCHANT_ID=
DEBITOPAY_WALLET_CODE=
DEBITOPAY_API_BASE_URL=https://gyqoaningqhurhvdugne.supabase.co/functions/v1
DEBITOPAY_PAYMENT_ENDPOINT=payment-orchestrator
DEBITOPAY_WEBHOOK_SECRET=
# Optional fallback return URL for hosted card / PayFast checkout. A storefront
# should normally pass data.return_url when creating the payment session.
DEBITOPAY_RETURN_URL=
