# Vercel container entrypoint for the Medusa v2 API.
FROM node:22-alpine AS build
WORKDIR /app
RUN apk add --no-cache libc6-compat

COPY package.json package-lock.json* ./
RUN npm ci --no-audit --no-fund || npm install --no-audit --no-fund

COPY . .
RUN npm run build

FROM node:22-alpine AS runtime
WORKDIR /app
ENV NODE_ENV=production \
    PORT=80

COPY start.sh /app/start.sh
COPY reset-admin-password.cjs /app/reset-admin-password.cjs
RUN chmod +x /app/start.sh && mkdir -p /app/.medusa
COPY --from=build /app/.medusa/server /app/.medusa/server
RUN cd /app/.medusa/server \
  && (npm ci --omit=dev --no-audit --no-fund || npm install --omit=dev --no-audit --no-fund) \
  && npm cache clean --force

EXPOSE 80
CMD ["sh", "/app/start.sh"]
