# Copy into your local/private environment only; never commit real credentials.
# Use the connection string from Neon account NHatingo > AveartBackend > aveart-medusa-staging.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

NODE_ENV=production
PORT=9000
MEDUSA_WORKER_MODE=shared
MIGRATE_ON_BOOT=false

# Generate unique random secrets; do not reuse sample values.
JWT_SECRET=replace-with-a-long-random-secret
COOKIE_SECRET=replace-with-a-different-long-random-secret
MEDUSA_ADMIN_EMAIL=delcidioeliasnhatingo@gmail.com
MEDUSA_ADMIN_PASSWORD=replace-with-a-strong-password

# Replace with actual HTTPS origins before deployment.
ADMIN_CORS=https://your-admin-origin.example
AUTH_CORS=https://your-storefront-origin.example,https://your-admin-origin.example
STORE_CORS=https://your-storefront-origin.example

DEBITOPAY_API_KEY=
DEBITOPAY_MERCHANT_ID=
DEBITOPAY_WALLET_CODE=
DEBITOPAY_API_BASE_URL=https://gyqoaningqhurhvdugne.supabase.co/functions/v1
DEBITOPAY_PAYMENT_ENDPOINT=payment-orchestrator
DEBITOPAY_WEBHOOK_SECRET=
DEBITOPAY_RETURN_URL=https://your-storefront-origin.example/checkout/return
